# Keep this file private. Never copy the provider key or service token into Pages.
MENTOR_HOST=127.0.0.1
MENTOR_PORT=8082
MENTOR_PROVIDER=ollama
MENTOR_MODEL=
MENTOR_API_TOKEN=
MENTOR_ALLOWED_ORIGINS=https://xero-x.me,http://localhost:3000,http://localhost:3008
MENTOR_MAX_REQUESTS_PER_MINUTE=12
MENTOR_MAX_OUTPUT_TOKENS=1200

# Ollama: plain HTTP is allowed only for loopback. A remote Ollama host must use HTTPS.
MENTOR_OLLAMA_BASE_URL=http://127.0.0.1:11434
MENTOR_OLLAMA_API_TOKEN=

# OpenAI: select MENTOR_PROVIDER=openai and set the key only in this server environment.
OPENAI_API_KEY=
# Optional rates for cost estimates, in USD per one million tokens for the selected model.
# Leave empty to report token usage without inventing a price.
MENTOR_INPUT_USD_PER_MILLION=
MENTOR_OUTPUT_USD_PER_MILLION=
